#!/bin/bash
# KidsLab-Begruessung fuer interaktive Shells (bash + zsh).

_kidslab_welcome() {
    local RED='\033[1;31m'
    local YEL='\033[1;33m'
    local CYN='\033[1;36m'
    local GRN='\033[1;32m'
    local WHT='\033[1;37m'
    local DIM='\033[2;37m'
    local RST='\033[0m'

    echo ""
    echo -e "${RED}  ██╗  ██╗██╗██████╗ ███████╗██╗      █████╗ ██████╗ ${RST}"
    echo -e "${RED}  ██║ ██╔╝██║██╔══██╗██╔════╝██║     ██╔══██╗██╔══██╗${RST}"
    echo -e "${YEL}  █████╔╝ ██║██║  ██║███████╗██║     ███████║██████╔╝${RST}"
    echo -e "${YEL}  ██╔═██╗ ██║██║  ██║╚════██║██║     ██╔══██║██╔══██╗${RST}"
    echo -e "${CYN}  ██║  ██╗██║██████╔╝███████║███████╗██║  ██║██████╔╝${RST}"
    echo -e "${CYN}  ╚═╝  ╚═╝╚═╝╚═════╝ ╚══════╝╚══════╝╚═╝  ╚═╝╚═════╝${RST}"
    echo ""
    echo -e "  ${WHT}Willkommen im KidsLab! Viel Spaß beim Coden 🚀${RST}"
    echo ""
    echo -e "  ${DIM}Rechner :${RST}  ${GRN}$(hostname)${RST}"
    echo -e "  ${DIM}Datum   :${RST}  $(date '+%A, %d. %B %Y – %H:%M Uhr')"
    if [ -f /etc/ansible-pull-status ]; then
        STATUS=$(cat /etc/ansible-pull-status)
        echo -e "  ${DIM}Update  :${RST}  ${GRN}${STATUS}${RST}"
    else
        echo -e "  ${DIM}Update  :${RST}  ${YEL}Noch kein Update gelaufen${RST}"
    fi
    echo ""
    echo -e "  ${DIM}Tipp: Tippe ${RST}${CYN}update${RST}${DIM}, um das System zu aktualisieren.${RST}"
    echo ""
}

# In zsh loescht die Manjaro-zsh-Config beim ersten Prompt-Aufbau den
# Bildschirm (und Powerlevel10k faengt Ausgaben waehrend der Init ab),
# wodurch eine direkt beim Sourcen ausgegebene Begruessung verschwindet.
# Ausgabe daher ueber einen precmd-Hook nach der Init zeigen.
#
# Das Script wird auf Manjaro zweimal geladen: zuerst ueber
# /etc/zsh/zprofile -> /etc/profile -> /etc/profile.d/ (dort ueberlebt der
# Hook die spaetere .zshrc-Init nicht), dann ueber die Einbindung in
# ~/.zshrc. Deshalb KEIN Guard-Flag, sondern den Hook bei jeder Ladung neu
# ans ENDE der precmd-Kette setzen (nach dem Manjaro-clear). add-zsh-hook
# registriert nicht doppelt; der Hook meldet sich nach dem ersten Feuern ab.
if [ -n "$ZSH_VERSION" ]; then
    autoload -Uz add-zsh-hook
    _kidslab_welcome_once() {
        _kidslab_welcome
        add-zsh-hook -d precmd _kidslab_welcome_once
        unset -f _kidslab_welcome_once 2>/dev/null
    }
    add-zsh-hook -d precmd _kidslab_welcome_once 2>/dev/null
    add-zsh-hook precmd _kidslab_welcome_once
else
    # bash: direkte Ausgabe, aber nur einmal (Login via profile.d + .bashrc).
    [ -n "$KIDSLAB_WELCOME_SHOWN" ] && return
    export KIDSLAB_WELCOME_SHOWN=1
    _kidslab_welcome
fi
