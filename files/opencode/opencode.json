{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kidslab": {
      "name": "KidsLab",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ki.kidslab.de/api-ext/v1",
        "headers": {
          "Authorization": "{file:kidslab-auth}",
          "X-Learn-Id": "{file:learn-id}"
        }
      },
      "models": {
        "qwen": {
          "name": "Qwen",
          "id": "qwen3.8:27b",
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 163840,
            "output": 16384
          },
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "enabled_providers": [
    "kidslab"
  ],
  "model": "kidslab/qwen",
  "permission": {
    "external_directory": "ask"
  },
  "websearch": {
    "provider": "tinyfish"
  }
}
