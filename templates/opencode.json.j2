{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "kidslab": {
      "name": "KidsLab (Arbeiten)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ki.kidslab.de/api-ext/v1",
        "apiKey": "{{ kidslab_api_key }}"
      },
      "models": {
        "qwen": {
          "name": "Qwen (ohne Log)",
          "id": "qwen3.8:27b",
          "limit": { "context": 163840, "output": 32000 }
        }
      }
    },
    "kidslab-learn": {
      "name": "KidsLab (Lernen)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ki.kidslab.de/api-learn/v1",
        "apiKey": "{{ kidslab_api_key }}",
        "headers": {
          "X-Learn-Id": "{{ ansible_facts['hostname'] }}"
        }
      },
      "models": {
        "qwen": {
          "name": "Qwen (mit Log)",
          "id": "qwen3.8:27b",
          "limit": { "context": 163840, "output": 32000 }
        }
      }
    },
    "kidslab-cloud": {
      "name": "KidsLab (Cloud)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{{ openrouter_api_key }}"
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash"
        }
      }
    }
  },
  "enabled_providers": ["kidslab", "kidslab-learn", "kidslab-cloud"],
  "model": "kidslab/qwen"
}
