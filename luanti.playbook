- hosts: localhost
  connection: local
  become: yes

  tasks:

  - name: Flatpak installieren
    ansible.builtin.pacman:
      name: flatpak
      state: present
      update_cache: yes

  - name: Flathub Repository hinzufuegen
    community.general.flatpak_remote:
      name: flathub
      state: present
      flatpakrepo_url: https://dl.flathub.org/repo/flathub.flatpakrepo
      method: system

  - name: Luanti installieren
    community.general.flatpak:
      name: org.luanti.luanti
      state: present

  - name: LÖVE2D (Lua-Framework) installieren
    ansible.builtin.pacman:
      name: love
      state: present

  - name: Luanti Config-Verzeichnis erstellen
    ansible.builtin.file:
      path: "/home/kidslab/.var/app/org.luanti.luanti/.minetest/"
      owner: kidslab
      group: kidslab
      mode: '0777'
      state: directory

  - name: Luanti Serverlist-Verzeichnis erstellen
    ansible.builtin.file:
      path: "/home/kidslab/.var/app/org.luanti.luanti/.minetest/client/serverlist/"
      owner: kidslab
      group: kidslab
      mode: '0777'
      state: directory

  - name: Luanti Einstellungen kopieren
    ansible.builtin.copy:
      src: minetest.conf
      dest: /home/kidslab/.var/app/org.luanti.luanti/.minetest/minetest.conf
      owner: kidslab
      group: kidslab
      mode: '0777'

  - name: Luanti Serverliste kopieren
    ansible.builtin.copy:
      src: favoriteservers.json
      dest: /home/kidslab/.var/app/org.luanti.luanti/.minetest/client/serverlist/favoriteservers.json
      owner: kidslab
      group: kidslab
      mode: '0777'

  - name: Chromium installieren
    ansible.builtin.pacman:
      name: chromium
      state: present

  - name: Verzeichnis fuer Chromium-Richtlinien anlegen
    ansible.builtin.file:
      path: /etc/chromium/policies/managed
      state: directory
      mode: '0755'

  - name: Chromium-Startseite auf mos.kidslab.de setzen
    ansible.builtin.copy:
      dest: /etc/chromium/policies/managed/kidslab.json
      mode: '0644'
      content: |
        {
          "HomepageLocation": "https://mos.kidslab.de",
          "HomepageIsNewTabPage": false,
          "ShowHomeButton": true,
          "RestoreOnStartup": 4,
          "RestoreOnStartupURLs": ["https://mos.kidslab.de"],
          "NewTabPageLocation": "https://mos.kidslab.de"
        }

  - name: .config-Verzeichnis fuer kidslab sicherstellen
    ansible.builtin.file:
      path: /home/kidslab/.config
      state: directory
      owner: kidslab
      group: kidslab
      mode: '0755'

  # Bei Autologin ohne Passwort bleibt der GNOME-Keyring gesperrt, wodurch
  # Chromium beim Start nach dem Keyring-Passwort fragt. --password-store=basic
  # verzichtet auf den System-Keyring und unterbindet die Abfrage.
  - name: Chromium-Keyring-Abfrage unterbinden (password-store=basic)
    ansible.builtin.copy:
      dest: /home/kidslab/.config/chromium-flags.conf
      owner: kidslab
      group: kidslab
      mode: '0644'
      content: |
        --password-store=basic

  - name: Luanti und Chromium in GNOME-Schnellstartleiste
    become_user: kidslab
    community.general.dconf:
      key: "/org/gnome/shell/favorite-apps"
      value: "['firefox.desktop', 'chromium.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Console.desktop', 'org.luanti.luanti.desktop']"

  - name: MOTD-Script fuer ansible-pull Status
    ansible.builtin.copy:
      src: 99-ansible-pull
      dest: /etc/profile.d/ansible-pull-status.sh
      owner: root
      group: root
      mode: '0755'
