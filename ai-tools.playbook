- hosts: localhost
  connection: local
  become: yes
  vars:
    the_user: "kidslab"
    # Wird in files/opencode/opencode.json hineingemischt (nur Kursraum).
    opencode_kursraum:
      provider:
        kidslab-cloud:
          name: "KidsLab (Cloud)"
          npm: "@ai-sdk/openai-compatible"
          options:
            baseURL: "https://openrouter.ai/api/v1"
            apiKey: "{file:openrouter-key}"
          models:
            "deepseek/deepseek-v4-flash":
              name: "DeepSeek V4 Flash"
      enabled_providers: ["kidslab-cloud"]
  vars_files:
    - vars/vault.yml

  tasks:

  # --- OpenCode ---

  - name: OpenCode installieren / aktualisieren
    ansible.builtin.pacman:
      name: opencode
      state: latest

  - name: OpenCode Config-Verzeichnis erstellen
    ansible.builtin.file:
      path: "/home/{{ the_user }}/.config/opencode"
      state: directory
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0755'

  # Eine Config fuer alle: files/opencode/opencode.json ist die einzige Quelle.
  # Die Hackerwerkstatt-Setup-Scripts (Heimrechner) laden genau diese Datei
  # ueber raw.githubusercontent.com. Sie enthaelt keine Geheimnisse; Zugang
  # und Lern-Name kommen per {file:...} aus zwei Nachbardateien (Pfad relativ
  # zur opencode.json, abschliessender Zeilenumbruch wird ignoriert).
  # Nur hier im Kursraum kommt der Cloud-Provider dazu (OpenRouter-Key aus
  # dem Vault) -- zu Hause gibt es den Key nicht, ein {file:...} auf eine
  # fehlende Datei wird zum leeren String, und die Kinder saehen einen
  # Provider, der nur Fehler liefert.
  - name: OpenCode Zugang (Bearer-Key) deployen
    ansible.builtin.copy:
      content: "Bearer {{ kidslab_api_key }}"
      dest: "/home/{{ the_user }}/.config/opencode/kidslab-auth"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0600'

  - name: OpenCode Lern-Name (X-Learn-Id = Rechnername) deployen
    ansible.builtin.copy:
      content: "{{ ansible_facts['hostname'] }}"
      dest: "/home/{{ the_user }}/.config/opencode/learn-id"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0644'

  - name: OpenCode OpenRouter-Key deployen
    ansible.builtin.copy:
      content: "{{ openrouter_api_key }}"
      dest: "/home/{{ the_user }}/.config/opencode/openrouter-key"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0600'

  - name: OpenCode Konfiguration deployen (zentrale Datei + Kursraum-Extras)
    ansible.builtin.copy:
      content: "{{ (lookup('ansible.builtin.file', 'files/opencode/opencode.json') | from_json)
                   | combine(opencode_kursraum, recursive=True, list_merge='append')
                   | to_nice_json(indent=2) }}\n"
      dest: "/home/{{ the_user }}/.config/opencode/opencode.json"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0644'

  - name: OpenCode Mentor-Systemprompt deployen
    ansible.builtin.copy:
      src: files/opencode-mentor.md
      dest: "/home/{{ the_user }}/.config/opencode/AGENTS.md"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0644'

  - name: OpenCode Plugin-Verzeichnis erstellen
    ansible.builtin.file:
      path: "/home/{{ the_user }}/.config/opencode/plugins"
      state: directory
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0755'

  - name: OpenCode Start-Hinweis (Logging) deployen
    ansible.builtin.copy:
      src: files/ki-logging-hint/tui.ts
      dest: "/home/{{ the_user }}/.config/opencode/plugins/ki-logging-hint/tui.ts"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0644'

  # V2 erwartet das Layout plugins/<name>/tui.ts. Die alte flache Datei
  # wuerde sonst als Server-Plugin geladen und beim Start crashen.
  - name: Alte flache Plugin-Datei entfernen (V1-Layout)
    ansible.builtin.file:
      path: "/home/{{ the_user }}/.config/opencode/plugins/ki-logging-hint.ts"
      state: absent

  # --- Qwen Code ---

  - name: Qwen Code installieren / aktualisieren
    ansible.builtin.pacman:
      name: qwen-code
      state: latest

  - name: Qwen Code Config-Verzeichnis erstellen
    ansible.builtin.file:
      path: "/home/{{ the_user }}/.qwen"
      state: directory
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0755'

  - name: Qwen Code Konfiguration deployen
    ansible.builtin.template:
      src: templates/qwen-settings.json.j2
      dest: "/home/{{ the_user }}/.qwen/settings.json"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0600'

  - name: Qwen Code Mentor-Systemprompt deployen
    ansible.builtin.copy:
      src: files/opencode-mentor.md
      dest: "/home/{{ the_user }}/.qwen/QWEN.md"
      owner: "{{ the_user }}"
      group: "{{ the_user }}"
      mode: '0644'

  # --- VS Code (Code-OSS) mit OpenCode-Extension ---

  - name: Code-OSS installieren
    ansible.builtin.pacman:
      name: code
      state: present

  - name: OpenCode-Extension fuer Code-OSS installieren
    become_user: "{{ the_user }}"
    ansible.builtin.command:
      cmd: code --install-extension sst-dev.opencode
    register: code_extension
    changed_when: "'already installed' not in code_extension.stdout"

  # --- Goose Desktop entfernen (wird nicht mehr genutzt) ---

  - name: Pruefen ob Goose Desktop installiert ist
    ansible.builtin.command: flatpak info io.github.block.Goose
    register: goose_installed
    changed_when: false
    failed_when: false

  - name: Goose Desktop deinstallieren
    ansible.builtin.command:
      cmd: flatpak uninstall --noninteractive --system io.github.block.Goose
    when: goose_installed.rc == 0
    changed_when: true

  - name: Goose Konfigurationsdaten entfernen
    ansible.builtin.file:
      path: "/home/{{ the_user }}/.var/app/io.github.block.Goose"
      state: absent
